# Added by OrbStack: 'orb' SSH host for Linux machines
# This only works if it's at the top of ssh_config (before any Host blocks).
# This won't be added again if you remove it.
Include ~/.orbstack/ssh/config

Host *
UseKeychain yes

Host iteragit.iteratec.de
    IdentityFile ~/.ssh/iteragit

Host iteratec.github.com
    # Usage in git: git@iteratec.github.com:<org>/<repository>
    HostName github.com
    IdentityFile ~/.ssh/iteratec.github

Host hannest117.github.com
    # Usage in git: git@hannest117.github.com:HannesT117/<repository>
    HostName github.com
    IdentityFile ~/.ssh/private-github_ed25519
